FROM python:3.13-slim

# Print Debian version during build (optional, uncomment to debug)
# RUN cat /etc/debian_version && \
#     cat /etc/os-release

WORKDIR /usr/src/app

ENV PYTHONPATH=/usr/src

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY ./requirements.txt .

RUN pip install --no-cache-dir --upgrade -r ./requirements.txt

# Copy everything (not just ./app)
COPY ./app/ .

# Copy the start script and normalise it (strip CRLF, make executable)
COPY ./start-all.sh /usr/src/app/start-all.sh
RUN sed -i 's/\r$//' /usr/src/app/start-all.sh && \
    chmod +x /usr/src/app/start-all.sh && \
    # sanity check: shebang should be exactly "#!/bin/bash"
    head -1 /usr/src/app/start-all.sh | grep -qx '#!/bin/bash'

# IMPORTANT: invoke bash explicitly so the script never runs under sh/dash,
# even if a Start Command override or a wrapper bypasses the shebang.
CMD ["/bin/bash", "/usr/src/app/start-all.sh"]