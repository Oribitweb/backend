# Required secrets (must be set in deployment environment)
SECRET_KEY=
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=

# Non-secret defaults (can be overridden)
ALGORITHM=HS256
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.filebase.io
S3_PUBLIC_ENDPOINT=https://s3.filebase.io
S3_BUCKET_NAME=orbit-bucket
S3_USE_PATH_STYLE=true
S3_USE_SSL=true

# Database (set in deployment)
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Sprite generation
SPRITE_INTERVAL=5
SPRITE_TILE_WIDTH=160
SPRITE_TILE_HEIGHT=90
SPRITE_COLUMNS=10
SPRITE_MAX_TILES=100

# Redis for websocket pubsub
REDIS_WS_PUBSUB=redis://redis:6379/1

# Sentry (optional)
SENTRY_DSN=
